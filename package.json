{
  "name": "bicameral-ai",
  "description": "Split-brain AI orchestration: Research-backed design thinking meets code implementation. Turn ideas into production apps with geometric precision.",
  "private": false,
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "version": "2.0.0",
  "author": {
    "name": "Libriopal Team",
    "email": "team@libriopal.ai",
    "url": "https://libriopal.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/libriopal/bolt.libriopal.git"
  },
  "keywords": [
    "ai",
    "bicameral",
    "design-thinking",
    "code-generation",
    "cohere",
    "research-backed",
    "full-stack",
    "lattice-visualization"
  ],
  "scripts": {
    "deploy": "npm run build && wrangler pages deploy",
    "build": "remix vite:build",
    "dev": "node pre-start.cjs && remix vite:dev",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint app",
    "lint:fix": "npm run lint -- --fix && prettier app --write",
    "type:check": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "start:windows": "wrangler pages dev ./build/client",
    "start:unix": "bindings=$(./bindings.sh) && wrangler pages dev ./build/client $bindings",
    "start": "node -e \"const { spawn } = require('child_process'); const isWindows = process.platform === 'win32'; const cmd = isWindows ? 'npm run start:windows' : 'npm run start:unix'; const child = spawn('node', ['-e', `require('child_process').spawn('${cmd}', { stdio: 'inherit' })`], { shell: true, stdio: 'inherit' }); process.on('SIGINT', () => child.kill('SIGINT'));\"",
    "preview": "pnpm run build && pnpm run start",
    "prepare": "husky",
    "clean": "node scripts/clean.js",
    "typecheck": "tsc",
    "typegen": "wrangler types",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.47",
    "@ai-sdk/anthropic": "^4.0.33",
    "@ai-sdk/cohere": "^1.0.3",
    "@ai-sdk/deepseek": "^3.0.24",
    "@ai-sdk/google": "^4.0.36",
    "@ai-sdk/mistral": "^4.0.25",
    "@ai-sdk/openai": "^4.0.33",
    "@clerk/react": "^6.13.0",
    "@clerk/remix": "^4.1.2",
    "@hookform/resolvers": "^3.3.4",
    "@nanostores/react": "^1.1.0",
    "@octokit/rest": "^22.0.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@prisma/client": "^5.10.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^9.108.0",
    "@react-three/fiber": "^8.15.12",
    "@remix-run/cloudflare": "^2.10.0",
    "@remix-run/react": "^2.10.0",
    "@unocss/reset": "^66.7.5",
    "@webcontainer/api": "^1.6.4",
    "@xterm/xterm": "^6.0.0",
    "ai": "^4.3.19",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cohere-ai": "^7.13.0",
    "date-fns": "^3.3.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.16.16",
    "isbot": "^4.1.0",
    "isomorphic-git": "^1.40.0",
    "istextorbinary": "^9.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.408.0",
    "nanostores": "^1.4.2",
    "next-themes": "^0.2.1",
    "ollama-ai-provider": "^1.2.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "react-qrcode-logo": "^4.1.0",
    "react-toastify": "^11.1.0",
    "react-window": "^1.8.11",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remix-island": "^0.2.0",
    "remix-utils": "^10.0.0",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^3.4.1",
    "three": "^0.156.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230724.0",
