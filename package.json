{
  "name": "bicameral-ai",
  "description": "Split-brain AI orchestration: Research-backed design thinking meets code implementation. Turn ideas into production apps with geometric precision.",
  "private": false,
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "version": "2.0.0",
  "author": {
    "name": "Libriopal Team",
    "email": "team@libriopal.ai",
    "url": "https://libriopal.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/libriopal/bolt.libriopal.git"
  },
  "keywords": [
    "ai",
    "bicameral",
    "design-thinking",
    "code-generation",
    "cohere",
    "research-backed",
    "full-stack",
    "lattice-visualization"
  ],
  "scripts": {
    "deploy": "npm run build && wrangler pages deploy",
    "build": "remix vite:build",
    "dev": "node pre-start.cjs && remix vite:dev",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint app",
    "lint:fix": "npm run lint -- --fix && prettier app --write",
    "type:check": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "start:windows": "wrangler pages dev ./build/client",
    "start:unix": "bindings=$(./bindings.sh) && wrangler pages dev ./build/client $bindings",
    "start": "node -e \"const { spawn } = require('child_process'); const isWindows = process.platform === 'win32'; const cmd = isWindows ? 'npm run start:windows' : 'npm run start:unix'; const child = spawn('node', ['-e', `require('child_process').spawn('${cmd}', { stdio: 'inherit' })`], { shell: true, stdio: 'inherit' }); process.on('SIGINT', () => child.kill('SIGINT'));\"",
    "preview": "pnpm run build && pnpm run start",
    "prepare": "husky",
    "clean": "node scripts/clean.js",
    "typecheck": "tsc",
    "typegen": "wrangler types",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@remix-run/cloudflare": "^2.10.0",
    "@remix-run/react": "^2.10.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slot": "^2.1.0",
    "@react-three/fiber": "^8.15.12",
    "@react-three/drei": "^9.108.0",
    "@hookform/resolvers": "^3.3.4",
    "@ai-sdk/cohere": "^1.0.3",
    "@prisma/client": "^5.10.0",
    "@clerk/remix": "^4.1.2",
    "@clerk/react": "^4.31.0",
    "ai": "^3.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cohere-sdk": "^7.8.0",
    "date-fns": "^3.3.1",
    "framer-motion": "^10.16.16",
    "isbot": "^4.1.0",
    "lucide-react": "^0.408.0",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "tailwindcss": "^3.4.1",
    "three": "^r156",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.10.0",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitest/ui": "^1.1.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.33",
    "prettier": "^3.1.1",
    "prisma": "^5.10.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.1.1"
  },
  "lint-staged": {
    "app/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
